# ==============================================================
# Unlock My Surprise — Environment Variables Configuration
# ==============================================================
# Copy this file to .env and fill in your values:
# cp .env.example .env

# --- Email Notification Settings (Resend) ---
# Get your free API key at https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here

# Your email address where you will receive his unlock attempts:
NOTIFICATION_EMAIL=your-email@example.com

# Verified sender email address (Resend free tier provides 'onboarding@resend.dev'):
FROM_EMAIL=Unlock My Surprise <onboarding@resend.dev>

# --- Secret Level Passwords (Optional Customization) ---
# Defaults match your relationship timeline (DDMMYYYY format):
# Level 1: Date of our first text (23 August 2023 -> 23082023)
LEVEL_1_PASSWORD=23082023

# Level 2: Date of our first in-person meeting (15 September 2023 -> 15092023)
LEVEL_2_PASSWORD=15092023

# Level 3: Date of our magical first kiss (13 July 2025 -> 13072025)
LEVEL_3_PASSWORD=13072025

# Level 4: Date of our first phone call (16 September 2023 -> 16092023)
LEVEL_4_PASSWORD=16092023

# Level 5: Date of our official anniversary (15 August 2025 -> 15082025)
LEVEL_5_PASSWORD=15082025

# Level 6: Date of his birth (8 November 2005 -> 08112005)
LEVEL_6_PASSWORD=08112005
